library(ggformula)
library(mosaic)
library(readr)
library(gridExtra)
library(tidyverse)
library(GGally)
library(broom)
library(grid)
library(pracma)
library(leaps)
best_subset <- regsubsets(total_cup_points ~ aftertaste + aroma + body + flavor,  data = coffee_data, nbest = 1)
with(summary(best_subset), data.frame(rsq, adjr2, cp, rss, outmat))
subset_model <- lm(total_cup_points ~ aftertaste + aroma +  body + flavor, data = coffee_data)
library(car)
vif(subset_model)
subset_model <- lm(total_cup_points ~ aftertaste + aroma +  body + flavor, data = coffee_data)
library(car)
vif(subset_model)
final_model <- lm(total_cup_points ~ flavor + aftertaste + aroma, data = coffee_data)
summary(final_model)
final_model <- lm(total_cup_points ~ aroma + aftertaste + flavor, data = coffee_data)
summary(final_model)
View(coffee_data)
