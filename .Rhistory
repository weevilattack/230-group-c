library(ggformula)
library(mosaic)
library(readr)
library(gridExtra)
library(tidyverse)
library(GGally)
library(broom)
library(grid)
coffee_data <- read_csv("https://raw.githubusercontent.com/rfordatascience/tidytuesday/06bca976827f922af8c1f62db67e6c1a7f0dcd4b/data/2020/2020-07-07/coffee_ratings.csv")
coffee_data <- coffee_data |>
filter(total_cup_points > 1) |>
select(total_cup_points, aftertaste, aroma, body, flavor, moisture, species)
# making tests mod so we can see equal variance of each quant pred vs total cup pts
aftertastemod <- lm(total_cup_points ~ aftertaste, data = coffee_data)
aromamod <- lm(total_cup_points ~ aroma, data = coffee_data)
bodymod <- lm(total_cup_points ~ body, data = coffee_data)
flavormod <- lm(total_cup_points ~ flavor, data = coffee_data)
moisturemod <- lm(total_cup_points ~ moisture, data = coffee_data)
# Make a resids plot for each individual quant predictor vs cup points
# Residual plots for aftertaste, aroma, body,flavor, moisture respectively
aftertasteresids <- mplot(aftertastemod, which = 1)
aromaresids <- mplot(aromamod, which = 1)
bodyresids <- mplot(bodymod, which = 1)
flavorresids <- mplot(flavormod, which = 1)
moistureresids <- mplot(moisturemod, which = 1)
note <- textGrob("",
gp = gpar(fontsize = 10),
just = "left")
# Organize all resid plots
grid.arrange(aftertasteresids, aromaresids, bodyresids, flavorresids, moistureresids, nrow = 2)
# Organize all resid plots
grid.arrange(aftertasteresids, aromaresids, bodyresids, flavorresids, moistureresids, nrow = 2)
# Plot the histograms and bar chart
grid.arrange(
p9,
grid.arrange(p1, p3, p4, p6, p7, p8, nrow = 2),
widths = c(1, 3)
)
# Create individual histograms
p1 <- gf_density(~ total_cup_points, data = coffee_data, binwidth = 0.3, fill = "lightblue") %>%
gf_labs(title = "Distribution of\nTotal Cup Points", x = "Rating", y = "Count")
p3 <- gf_density(~ aftertaste, data = coffee_data, binwidth = 0.3, fill = "lightblue") %>%
gf_labs(title = "Distribution of\nAftertaste ", x = "Rating", y = "Count")
p4 <- gf_density(~ aroma, data = coffee_data, binwidth = 0.3, fill = "lightblue") %>%
gf_labs(title = "Distribution of\nAroma ", x = "Rating", y = "Count")
p6 <- gf_density(~ body, data = coffee_data, binwidth = 0.3, fill = "lightblue") %>%
gf_labs(title = "Distribution of\nBody ", x = "Rating", y = "Count")
p7 <- gf_density(~ flavor, data = coffee_data, binwidth = 0.3, fill = "lightblue") %>%
gf_labs(title = "Distribution of\nFlavor ", x = "Rating", y = "Count")
p8 <- gf_density(~ moisture, data = coffee_data, binwidth = 0.01, fill = "lightblue") %>%
gf_labs(title = "Distribution of\nMoisture", x = "Moisture (%)", y = "Count") %>%
gf_refine(scale_x_continuous(labels = percent_format(accuracy = 1)))
# Bar chart for counts of species
p9 <- gf_bar(~ species, data = coffee_data, fill = "lightblue") |>
gf_labs(title = "Bar Chart of Species",
x = "Species", y="Count")
# Plot the histograms and bar chart
grid.arrange(
p9,
grid.arrange(p1, p3, p4, p6, p7, p8, nrow = 2),
widths = c(1, 3)
)
coffee_data <- coffee_data |>
filter(species == "Arabica")
# Organize all resid plots
grid.arrange(aftertasteresids, aromaresids, bodyresids, flavorresids, moistureresids, nrow = 1)
# Organize all resid plots
# before transformation
grid.arrange(aftertasteresids, aromaresids, bodyresids, flavorresids, moistureresids, nrow = 1)
PT <- powerTransform(cbind(aftertasteresids,
aromaresids,
bodyresids,
flavorresids,
moistureresids) ~ 1)
library(car)
PT <- powerTransform(cbind(aftertasteresids,
aromaresids,
bodyresids,
flavorresids,
moistureresids) ~ 1)
PT <- powerTransform(cbind(aftertasteresids,
aromaresids,
bodyresids,
flavorresids,
moistureresids) ~ 1)
# Transform variables
mutate(
# box cox  transforms with lambda=.25
aftertaste_t = (aftertaste^0.25 - 1) / 0.25,
aroma_t      = (aroma^0.25 - 1) / 0.25,
body_t       = (body^0.25 - 1)/ 0.25,           # λ = 0.5
flavor_t     = (flavor^0.25 - 1)/ 0.25,      # shift +1 so there are no zeros
)
# Transform variables
coffee_data <- coffee_data |>
mutate(
